# Database (compose starts PostgreSQL; set a password)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lehde
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Uploaded documents and feedback screenshots
DATA_DIR=data

# OpenAI-compatible AI provider with EU hosting and zero data retention.
# Langdock (EU): https://api.langdock.com/openai/eu/v1
LLM_BASE_URL=https://api.langdock.com/openai/eu/v1
API_KEY=
# A vision-capable model with structured output (Responses API)
MODEL=
LLM_CONCURRENCY=4

# Scanned pages: Tesseract languages, minimum text per page before OCR runs
OCR_LANGUAGES=deu+eng
OCR_MIN_TEXT_CHARACTERS=25
# Minimum similarity (0-100) for a quote to count as found in the document
CITATION_MIN_SCORE=88

CORS_ORIGINS=["http://localhost:5173"]
APP_URL=http://localhost:5173

# Optional: post each feedback ticket as JSON to a ticket system / Teams / Slack webhook
FEEDBACK_WEBHOOK_URL=

# Customer name shown in the header (frontend build)
VITE_CUSTOMER_NAME=Lehde
